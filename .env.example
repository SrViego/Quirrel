# Opcional: API xAI (Grok) para conversa mais inteligente
# https://console.x.ai/
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini
# Timeout da API em ms (cai pro modo local se estourar)
# XAI_TIMEOUT_MS=30000
# Atenção: no modo xAI, nome, últimas notas e humor vão junto pra API (ver README)

# Como te chamar (default: do sistema / viajante)
# USER_NAME=Viego

# Tema do terminal
# moss | void | pale | coral | dirt
# QUIRREL_THEME=moss
